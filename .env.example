DISCORD_TOKEN=put-your-bot-token-here
# Optional for fast slash-command sync while testing. Use your Discord server ID.
DISCORD_GUILD_ID=
# Required for website login. Use the same Discord application as the bot.
DISCORD_CLIENT_ID=put-your-application-id-here
DISCORD_CLIENT_SECRET=put-your-oauth2-client-secret-here
# Optional. Defaults to POKER_PUBLIC_BASE_URL/oauth/callback.
DISCORD_REDIRECT_URI=
# Optional. Defaults to OAuth/client secrets. Set this for stable signed sessions across redeploys.
POKER_SESSION_SECRET=
POKER_DB_PATH=poker_stats.sqlite3
# Optional: append public state-change events here for future multi-bot sync.
POKER_SYNC_EVENT_LOG=
# Local browser table service. Use 0.0.0.0 to expose inside your LAN.
POKER_WEB_HOST=127.0.0.1
POKER_WEB_PORT=8765
# Public URL shown in Discord. For remote players use a tunnel/domain, e.g. ngrok or Cloudflare Tunnel.
POKER_PUBLIC_BASE_URL=http://127.0.0.1:8765
